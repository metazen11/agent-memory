# agent-memory configuration
# Generated by install.js — edit as needed

# PostgreSQL
POSTGRES_USER=agentmem
POSTGRES_PASSWORD=        # REQUIRED — auto-generated by install.js
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agent_memory

# Or specify full URL (overrides components above)
# DATABASE_URL=postgresql://user:pass@host:port/db

# Embeddings (auto-downloaded on install)
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5

# Observation LLM — leave blank to skip local LLM (uses Anthropic Haiku)
OBSERVATION_LLM_MODEL=

# Anthropic API — required if OBSERVATION_LLM_MODEL is empty
ANTHROPIC_API_KEY=

# Embeddings — nomic requires trust_remote_code
EMBEDDING_TRUST_REMOTE_CODE=true

# Server
HOST=127.0.0.1
PORT=3377

# Security
ALLOW_TRUST_AUTH=false
CORS_ORIGINS=http://localhost:3377,http://127.0.0.1:3377
REQUIRE_AUTH=false          # set true after running: python -m app.cli setup

# Redaction (applied before storage)
REDACT_SECRETS=true
REDACT_PII=false

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WRITES_PER_MIN=100
RATE_LIMIT_READS_PER_MIN=500

# Audit logging (writes_only | all | off)
AUDIT_LOG_LEVEL=writes_only
AUDIT_RETENTION_DAYS=30

# Queue worker
QUEUE_POLL_INTERVAL=5
QUEUE_MAX_RETRIES=3
