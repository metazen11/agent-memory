#!/usr/bin/env bash
# pre-push — enforce the branching contract locally, on any machine.
#
# Installed by `git config core.hooksPath .githooks` (see repo-contract/install.sh).
# This is the LOCAL half of the contract; GitHub branch protection is the
# server-side half and the one that actually cannot be bypassed. This hook
# exists to fail FAST with a useful message, before a push round-trips.
#
# Refuses: any direct push to the production trunk (main/master).
#
# Override (audited, for genuine emergencies):
#   ALLOW_PROTECTED_PUSH=1 git push ...

set -uo pipefail

remote_ref_prod=""
for b in main master; do
    if git show-ref --verify --quiet "refs/remotes/origin/$b"; then remote_ref_prod="$b"; break; fi
done
[ -z "$remote_ref_prod" ] && exit 0   # no production trunk; nothing to protect

# stdin: <local ref> <local sha> <remote ref> <remote sha>
while read -r _lref _lsha rref _rsha; do
    [ -z "${rref:-}" ] && continue
    target="${rref#refs/heads/}"

    if [ "$target" = "$remote_ref_prod" ]; then
        if [ "${ALLOW_PROTECTED_PUSH:-}" = "1" ]; then
            echo "pre-push: WARNING — pushing directly to '$target' via ALLOW_PROTECTED_PUSH=1." >&2
            continue
        fi
        cat >&2 <<MSG

  ✗ pre-push REFUSED: direct push to '$target'.

    '$target' is the only trunk. It receives commits ONLY through a squash
    pull request from a feature branch (independent review + auditor PASS +
    green CI).

    Instead:
      git switch -c work/<topic>
      git push -u origin work/<topic>
      gh pr create --base $target --head work/<topic>

    GitHub branch protection will refuse this push too — this hook just
    tells you sooner. Genuine emergency: ALLOW_PROTECTED_PUSH=1 git push ...

MSG
        exit 1
    fi
done

exit 0
