{
  "venvPath": ".",
  "venv": ".venv-finetune",
  "pythonVersion": "3.14",
  "include": [
    "app",
    "scripts",
    "tests",
    "hooks"
  ],
  "exclude": [
    "**/__pycache__",
    "**/.venv*",
    "models",
    "data",
    "logs"
  ],
  "reportMissingImports": "warning",
  "reportOptionalMemberAccess": "warning"
}
