{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mz/agentMemory/schemas/eval-report.schema.json",
  "title": "Fine-tune Eval Report",
  "description": "Canonical structured input for the fine-tune eval test-report pipeline. Every eval run (single model or A/B) MUST emit one results.json conforming to this schema; scripts/fine_tune/render_test_report.py renders it to uniform markdown + HTML.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "run_date",
    "model",
    "harness",
    "eval_class",
    "gates",
    "prompts",
    "aggregate_stats",
    "verdict"
  ],
  "properties": {
    "report_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identifier for this report (e.g. 'v2-chat-template-retest-20260515'). Used as the report filename stem."
    },
    "run_date": {
      "type": "string",
      "format": "date",
      "description": "ISO 8601 date the eval was run (YYYY-MM-DD)."
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "quant"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Short model identifier, e.g. 'qwen2.5-3b-toolcalls-v2-q6k'."
        },
        "path": {
          "type": "string",
          "description": "Filesystem path or HF repo to the model artifact under test."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$",
          "description": "Optional SHA-256 of the model file for provenance."
        },
        "quant": {
          "type": "string",
          "description": "Quantization tier (e.g. 'Q6_K', 'Q4_K_M', 'bf16')."
        },
        "params": {
          "type": "string",
          "description": "Parameter count (e.g. '3B', '8B'). Free-form."
        }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "endpoint", "server"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Harness identifier (e.g. 'real_world.harness', 'harness_chat.py')."
        },
        "version": {
          "type": "string",
          "description": "Git SHA or semver of the harness."
        },
        "endpoint": {
          "type": "string",
          "description": "API endpoint exercised (e.g. '/v1/chat/completions')."
        },
        "server": {
          "type": "string",
          "description": "Inference server invocation (e.g. 'llama-server --jinja -c 8192')."
        },
        "temperature": { "type": "number" },
        "max_tokens": { "type": "integer", "minimum": 1 },
        "max_turns": { "type": "integer", "minimum": 1 }
      }
    },
    "eval_class": {
      "type": "string",
      "enum": ["A", "B", "C", "D", "E", "custom"],
      "description": "Which V3_PLAN.md §6 eval class this report covers. 'custom' for ad-hoc runs. E = project-specific recall."
    },
    "gates": {
      "type": "array",
      "description": "Pass/fail measurements with explicit thresholds. Order matters; rendered as-is.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "threshold", "actual", "units", "pass"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "threshold": {
            "description": "Threshold value the actual is compared against. Free-form to allow ranges like '<= 30%'.",
            "oneOf": [
              { "type": "string" },
              { "type": "number" }
            ]
          },
          "actual": {
            "oneOf": [
              { "type": "string" },
              { "type": "number" }
            ]
          },
          "units": { "type": "string", "description": "e.g. '%', 'count', 'violations'." },
          "pass": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    },
    "baselines": {
      "type": "array",
      "description": "Optional links to baseline runs to render a delta table against.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model_id", "summary"],
        "properties": {
          "model_id": { "type": "string" },
          "results_url": { "type": "string" },
          "summary": {
            "type": "object",
            "description": "Aggregate numbers from the baseline (same keys as this run's aggregate_stats so deltas are computable). Free-form key→number or key→string."
          }
        }
      }
    },
    "prompts": {
      "type": "array",
      "description": "Per-prompt outcomes. Order is preserved in the rendered table.",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "outcome", "n_turns"],
        "properties": {
          "id": {
            "oneOf": [
              { "type": "string" },
              { "type": "integer", "minimum": 1 }
            ]
          },
          "text": { "type": "string", "minLength": 1 },
          "expected_intent": { "type": "string" },
          "outcome": {
            "type": "string",
            "enum": [
              "useful_answer",
              "looped",
              "gave_up",
              "text_only_fallback",
              "max_turns",
              "error",
              "adapted_tool_call",
              "text_answer",
              "identical_reemit",
              "off_topic"
            ]
          },
          "n_turns": { "type": "integer", "minimum": 0 },
          "total_tokens": { "type": "integer", "minimum": 0 },
          "first_tool_call": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "arguments": {}
            }
          },
          "notes": { "type": "string" },
          "regressions": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Tags like 'in_args_repetition', 'post_tool_call_scaffolding', 'identical_reemit'."
            }
          }
        }
      }
    },
    "aggregate_stats": {
      "type": "object",
      "description": "Freeform summary numbers (e.g. 'useful_answer_rate': '0/10', 'mean_tokens': 1188). Rendered as a table.",
      "additionalProperties": true
    },
    "notable_findings": {
      "type": "string",
      "description": "Free-text section the operator fills in. Markdown is allowed; rendered verbatim into the report."
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "headline", "recommendation"],
      "properties": {
        "pass": { "type": "boolean" },
        "headline": {
          "type": "string",
          "minLength": 1,
          "description": "One-sentence summary, rendered into the verdict banner."
        },
        "recommendation": {
          "type": "string",
          "minLength": 1,
          "description": "<= 3 sentences guiding the next action."
        }
      }
    },
    "artifacts": {
      "type": "array",
      "description": "Raw transcripts, server logs, etc. Rendered as a list at the bottom of the report.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path"],
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "size_bytes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
